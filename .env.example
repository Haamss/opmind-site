# Gabarit d'environnement OpMind — aucune valeur réelle ici.
# Copier en .env.local et renseigner. .env.local n'est jamais commité.

# Projet Supabase. Exposées au navigateur (préfixe NEXT_PUBLIC_) : la clé
# anon est publique par conception, la sécurité repose sur les politiques RLS.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Lien de paiement Stripe pour la formule instructeur.
# Alimente le CTA « Passer au palier supérieur » (bandeau de palier expiré,
# blocages OM001 et OM002). Si la variable est absente, aucun CTA n'est
# affiché — jamais de lien mort.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_INSTRUCTOR=
